{
  "manifest_version": 3,
  "name": "IntelliBlock – AI-Powered Productivity Extension",
  "short_name": "IntelliBlock",
  "version": "0.1.0",
  "description": "A privacy-first, context-aware productivity blocker for YouTube and Reddit.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://www.reddit.com/*",
    "https://reddit.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "IntelliBlock",
    "default_popup": "src/options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "src/options.html",
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://www.reddit.com/*", "https://reddit.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self';" }
}
